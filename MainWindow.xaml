<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp1"
        mc:Ignorable="d"
        Title="Click Simulator" Icon="https://imagepng.org/mouse-click/mouse-click/" Height="450" Width="900">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="2*" />
            <RowDefinition Height="1.5*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <Viewbox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="10">
            <TextBlock x:Name="textozin" Text="0" FontWeight="Bold" HorizontalAlignment="Center"/>
        </Viewbox>

        <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
            <Button Content="Clique" Click="Click_vl" FontSize="22" Padding="20,10" Height="50" Width="200" HorizontalAlignment="Center"/>
            <TextBlock x:Name="ClickPS" Text="1 Clicks" FontSize="16" HorizontalAlignment="Center" Margin="0,5,0,0" Foreground="Gray"/>
        </StackPanel>

        <!-- ================= UPGRADE 1 ================= -->
        <TextBlock Grid.Row="2" Grid.Column="0" x:Name="Upgrade1" Text="+1 Click" FontSize="18" HorizontalAlignment="Center" Margin="5"/>
        <Button Grid.Row="3" Grid.Column="0" Content="Comprar (50)" x:Name="FirstUp" Click="Click_Upgrade" Margin="10" Padding="5"/>

        <!-- ================= UPGRADE 2 ================= -->
        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="Upgrade2" Text="+3 Clicks" FontSize="18" HorizontalAlignment="Center" Margin="5"/>
        <Button Grid.Row="3" Grid.Column="1" Content="Comprar (300)" x:Name="SecondUp" Click="Click_Upgrade" Margin="10" Padding="5"/>

        <!-- ================= UPGRADE INFINITO ================= -->
        <TextBlock Grid.Row="2" Grid.Column="2" x:Name="InfTexto" Text="+2 Clicks (inf)" FontSize="18" HorizontalAlignment="Center" Margin="5"/>
        <Button Grid.Row="3" Grid.Column="2" Content="Comprar (500)" x:Name="InfUp" Click="Click_Upgrade" Margin="10" Padding="5"/>

        <!-- ================= REBIRTH ================= -->
        <TextBlock Grid.Row="2" Grid.Column="3" x:Name="RebirthText" Text="Rebirth (Multi: 1x)" FontSize="18" HorizontalAlignment="Center" Margin="5"/>
        <Button Grid.Row="3" Grid.Column="3" Content="Resetar (5.000)" x:Name="RebirthButton" Click="Click_Upgrade" Margin="10" Padding="5"/>

    </Grid>
</Window>
